# Cliente (vai para o bundle; só chave publicável)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Servidor — runtime via Supavisor transaction pooler (porta 6543)
DATABASE_URL=

# Servidor — migrations via conexão direta/session pooler (porta 5432)
DIRECT_URL=

# PixaBay API Key
PIXABAY_API_KEY=

# Só na máquina de quem roda o seed e o envio de imagens; nunca na Vercel nem no GitHub
# (spec 003). SUPABASE_SERVICE_ROLE_KEY NÃO deve ficar em arquivo: passe no terminal, só na hora.
PROFESSOR_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=
CONFIRM_PROD=
