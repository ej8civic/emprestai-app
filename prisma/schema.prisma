generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  COLABORADOR
  OPERACOES
}

enum Category {
  NOTEBOOKS
  MONITORES
  CAMERAS
  CABOS
  PROJETORES
}

enum EquipmentStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships Membership[]
  equipment   Equipment[]
  loans       Loan[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model Membership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       Role
  name       String
  email      String
  department String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  loans      Loan[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

model Equipment {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  patrimonio     String
  name           String
  category       Category
  serial         String?
  pickupLocation String          @default("Balcão 2º andar") @map("pickup_location")
  description    String?
  notes          String?
  status         EquipmentStatus @default(AVAILABLE)
  imageUrl       String?         @map("image_url")
  imageSource    String?         @map("image_source")
  imageAuthor    String?         @map("image_author")
  imageLicense   String?         @map("image_license")
  imageSourceUrl String?         @map("image_source_url")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  loans          Loan[]

  @@unique([tenantId, patrimonio])
  @@index([tenantId, status])
  @@map("equipment")
}

model Loan {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  equipmentId  String     @map("equipment_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  loanedAt     DateTime   @default(now()) @map("loaned_at") @db.Timestamptz(6)
  dueAt        DateTime   @map("due_at") @db.Timestamptz(6)
  returnedAt   DateTime?  @map("returned_at") @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  equipment    Equipment  @relation(fields: [equipmentId], references: [id])
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@index([tenantId, returnedAt])
  @@index([membershipId, returnedAt])
  @@index([equipmentId])
  @@map("loans")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  resource   String
  resourceId String   @map("resource_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_log")
}
